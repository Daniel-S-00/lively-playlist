# Build output
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM/
ARM64/
artifacts/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Visual Studio / VS Code
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# Generated protobuf code (regenerated by Grpc.Tools at build time)
Protos/*Grpc.cs
Protos/*Messages.cs

# App runtime artifacts (created next to the exe on run)
playlist.json
lively-playlist.log
*.log

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local agent/tool config (contains machine-specific absolute paths)
.commandcode/

# Publish output
*.publish.xml
publish/
